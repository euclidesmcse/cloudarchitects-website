# =====================================================================
# Cloud Architects Website — Variáveis de Ambiente (EXEMPLO)
# =====================================================================
# Copie para .env e preencha com valores reais.
# NUNCA commite o arquivo .env (já está no .gitignore).
# =====================================================================

# Payload CMS — secret para assinatura de sessões (mínimo 32 caracteres)
# Gerar com: openssl rand -hex 32
PAYLOAD_SECRET=

# Email do administrador inicial do CMS
CMS_ADMIN_EMAIL=

# Senha do administrador inicial do CMS (mínimo 16 caracteres)
# Gerar com: openssl rand -base64 24
CMS_ADMIN_PASSWORD=
